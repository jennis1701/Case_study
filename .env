# ============================================================
# Bloom's Taxonomy LLM Classifier - Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values before running.
# Do NOT commit your .env file to version control.

# ----------------------------------------------------------
# Model Configuration
# ----------------------------------------------------------
# Hugging Face model identifier for Gemma 3.
# Examples:
#   google/gemma-3-1b-it       (smallest, CPU-friendly)
#   google/gemma-3-4b-it       (balanced)
#   google/gemma-3-12b-it      (high quality, needs GPU)
#   google/gemma-3-27b-it      (best quality, large GPU)
MODEL_NAME=google/gemma-3-1b-it
HF_TOKEN=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

# ----------------------------------------------------------
# Generation Parameters
# ----------------------------------------------------------
MAX_NEW_TOKENS=512
TEMPERATURE=0.1
TOP_P=0.9

# ----------------------------------------------------------
# Device Configuration
# ----------------------------------------------------------
# auto  = use CUDA if available, else CPU
# cuda  = force GPU (will error if unavailable)
# cpu   = force CPU
DEVICE=auto

# ----------------------------------------------------------
# Logging Configuration
# ----------------------------------------------------------
# Set to true to log inference results to a CSV file
ENABLE_LOGGING=true

# Path for the experiment log CSV
LOG_FILE_PATH=experiments/results_log.csv

# ----------------------------------------------------------
# Hugging Face Authentication
# ----------------------------------------------------------
# Required if the model is gated (e.g., Gemma requires accepting
# the license on https://huggingface.co/google/gemma-3-1b-it)
# Run: huggingface-cli login
# Or set this token here (do NOT commit to git)
# HF_TOKEN=hf_your_token_here
